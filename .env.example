# Copy to .env and fill in real values. .env is git-ignored — never commit it.
#   cp .env.example .env

### NASA NEO API — https://api.nasa.gov (DEMO_KEY works but is capped at 30 req/hr) ###
NASA_API_KEY=

### SMTP (Mailtrap sandbox by default — https://mailtrap.io) ###
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=alerts@asteroid.local

### MySQL — consumed by docker-compose and notification-service ###
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=asteroidalerting
MYSQL_USER=asteroid
MYSQL_PASSWORD=

### Kafka ###
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
