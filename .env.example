# Copy to .env and fill in real values. .env is git-ignored — never commit it.
#   cp .env.example .env

### NASA Open APIs - https://api.nasa.gov ###
# Get a free key. DEMO_KEY is capped at 30 requests/hour across EVERY api.nasa.gov
# endpoint - not 30 per endpoint - and one load of the web-ui home page spends four.
# Leaving this as DEMO_KEY makes the front end render mostly error pages.
NASA_API_KEY=

### SMTP (Mailtrap sandbox by default — https://mailtrap.io) ###
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=alerts@asteroid.local

### MySQL — consumed by docker-compose and notification-service ###
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=asteroidalerting
MYSQL_USER=asteroid
MYSQL_PASSWORD=

### Kafka ###
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
