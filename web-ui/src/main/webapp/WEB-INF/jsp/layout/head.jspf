<%--
  Shared page opening: doctype, head, nav, and the start of <main>.

  Included with <%@ include %> (static, at compile time) rather than <jsp:include>
  (dynamic, a request dispatch per include). Static include produces one compiled
  servlet per page and shares page-scoped variables; a dynamic include would mean an
  extra forward on every request for markup that never varies.

  The .jspf extension marks this as a fragment rather than a page anyone should
  request directly.

  TAGLIB URIs: these are the Jakarta EE ones. The java.sun.com/jsp/jstl/core URI in
  every pre-2020 tutorial is NOT declared by jakarta.servlet.jsp.jstl 3.0 and fails
  with "The absolute uri cannot be resolved".
--%>
<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%-- fmt is used for numbers only. <fmt:formatDate> is NOT usable here: JSTL 3.0
     still only accepts java.util.Date and Calendar, so handing it a LocalDate or an
     Instant fails at render time. Dates are formatted in Java by Formats instead. --%>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> &middot; Asteroid Watch</title>
    <%-- from src/main/resources/static, NOT src/main/webapp: Boot 4 defaults
         server.servlet.register-default-servlet to false, so nothing serves the
         document root except Jasper and a stylesheet under webapp/ would 404 --%>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css">
</head>
<body>
<%@ include file="nav.jspf" %>
<main class="wrap">
